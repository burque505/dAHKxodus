<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks of the mail merge (host\Merge.cs) on templates made here, one per kind of field, so each kind is tested
       whether or not anyone's own templates use it. dotnet run -c Release (from this folder); exit code 0 = all passed.
       Optional: dotnet run -c Release, then two dashes and template paths, scans (and merges with made-up values) other templates too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\host\Merge.cs" Link="Merge.cs" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\DocumentFormat.OpenXml.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\DocumentFormat.OpenXml.Framework.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\System.IO.Packaging.dll" />
  </ItemGroup>
</Project>
