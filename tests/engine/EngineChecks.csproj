<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless checks of the Docxodus engine dAHKxodus runs (lib\docxodus, built by build-engine.ps1), called the way
       the editor page calls it: NativeSessionBridge.Call("DocxSessionBridge.X", argsJson).
       dotnet run -c Release (from this folder); exit code 0 = every check passed or failed as known. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\DocxodusNativeBridge.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\Docxodus.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\DocumentFormat.OpenXml.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\DocumentFormat.OpenXml.Framework.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\docxodus\System.IO.Packaging.dll" />
  </ItemGroup>
</Project>
